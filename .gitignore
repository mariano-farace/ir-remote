# Per-developer bridge runtime state (not shared).
.specify/superpowers-handoff.json
.specify/bridge-events.jsonl
.specify/bridge-snapshots/
.superpowers/

# Machine-local Spec Kit install state.
.specify/feature.json
.specify/init-options.json
.specify/integration.json
.specify/integrations/*.manifest.json
.specify/extensions/.registry
.specify/extensions/.cache/
.specify/extensions/*/.specify-dev/
.specify/workflows/workflow-registry.json
.specify/workflows/.cache/
.specify/workflows/steps/.cache/
.specify/scripts/

# Dependencies and build output.
node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Test and tooling artifacts.
coverage/
playwright-report/
test-results/

# Local secrets. .env.example is tracked instead.
.env
.env.*
!.env.example

# Editor and OS noise.
.DS_Store
*.log
