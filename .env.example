# Copy to `.env` (or export these in your shell) before running the app.
#
# NARRATIVE ENGINE — required configuration
#
# Both OpenRouter values are required. The app refuses to start when either is
# missing, naming the variable, rather than falling back to a default model.

# Server-side only. Never exposed to the browser and never committed.
OPENROUTER_API_KEY=

# The model every AI request is made with, as an OpenRouter slug, for example
# `anthropic/claude-sonnet-4.5`. The model is configuration: changing it needs
# no code change.
OPENROUTER_MODEL=

# Optional. OpenRouter's API address; leave unset outside tests. The end-to-end
# suite starts its own server with this pointing at a stub it controls, so a
# scenario can be given a model that fails, hangs, or answers in prose.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NOTE — tool calling: model support varies. The workspace edits the script via
# the `apply_document_revision` tool, so a model that cannot produce a valid
# tool call makes the feature unusable (the workspace reports the error rather
# than writing a partial result). Before relying on a slug, confirm it supports
# tool calling on OpenRouter.

# PostgreSQL, used by the app (`npm run db:migrate`, `npm run db:seed`) and
# matching the `db` service in docker-compose.yml.
DATABASE_URL=postgres://narrative:narrative@localhost:5432/narrative_engine
